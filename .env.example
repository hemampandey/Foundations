# ── Supabase ──
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Optional: server-side key used by /api/generate-mcqs to verify sessions
SUPABASE_SERVICE_ROLE_KEY=

# ── AI provider (OpenRouter preferred; OpenAI-compatible fallback) ──
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=openai/gpt-4o-mini
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# OPENAI_MODEL=gpt-4o-mini

# ── Redis (optional; rate limiting + in-flight locks for AI generation) ──
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
GENERATION_RATE_LIMIT_PER_HOUR=10

# ── Misc ──
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Enables the dev-only role switcher
NEXT_PUBLIC_DEV_MODE=false
